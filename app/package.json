{
  "name": "pianke",
  "productName": "片刻",
  "version": "0.1.0",
  "description": "只推荐三部，每一部都懂你。本机运行 Spark-X2.5 的观影伙伴。",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "dist": "./scripts/build-backend.sh && electron-vite build && electron-builder --mac --arm64 && ./scripts/make-dmg.sh"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/node": "26.6.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "license": "Apache-2.0",
  "build": {
    "appId": "app.pianke.desktop",
    "productName": "片刻",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/pianke-backend",
        "to": "backend"
      },
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "catalog.sqlite",
          "library.sqlite",
          "bench_speed.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dir"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false
  }
}
